<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 配置：
   - 本地源 tools/nuget-local（离线引导下载的包，见 scripts/fetch-nuget.mjs）；
   - 官方源 nuget.org（正常联网机器可直接还原，无需本地源）。
  顺序上 local 在前：本机离线时包全部命中本地源，不会触发网络请求。
  全局包目录放在仓库内 tools/nuget-packages（已 gitignore），构建环境自包含。
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="tools/nuget-packages" />
  </config>
  <packageSources>
    <add key="local" value="tools/nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
